PORT=3000

# MusicBrainz requires a descriptive contact value in the User-Agent.
MUSICBRAINZ_CONTACT=https://github.com/ArS377/SearchEngine

# Optional: resolves exact Spotify track URLs through the official Web API.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: enables uploaded audio and humming identification.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Optional: enables the read-only OpenClaw assistant panel.
# Use "cli" for a local OpenClaw install, or "http" for a compatible REST bridge.
OPENCLAW_TRANSPORT=cli
OPENCLAW_CLI_PATH=openclaw
OPENCLAW_SESSION_KEY=agent:main:liner-notes
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=

# Optional: managed persistence and authentication.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: distributed provider caching and rate limiting.
# The application falls back to an in-process cache when omitted.
REDIS_URL=

# Optional: production error reporting and traces.
SENTRY_DSN=
